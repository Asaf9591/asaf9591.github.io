from PIL import Image, ImageDraw
import math

# Configuración de alta resolución (512x512 píxeles)
size = 512
img = Image.new("RGBA", (size, size), (15, 17, 23, 255))
draw = ImageDraw.Draw(img)

cx, cy = 256, 256
r_hex = 210

# Hexágono institucional de contorno (#262b3a)
hex_points = []
for i in range(6):
    angle_deg = 60 * i - 30
    angle_rad = math.radians(angle_deg)
    hex_points.append((cx + r_hex * math.cos(angle_rad), cy + r_hex * math.sin(angle_rad)))
draw.polygon(hex_points, outline=(38, 43, 58, 255), width=12)

# V exterior cinética (Indigo #6c5ce7)
v_ext = [(130, 140), (256, 410), (382, 140)]
draw.line(v_ext, fill=(108, 92, 231, 255), width=36, joint="curve")

# V interior técnica (Blanco suave #e6e8ef)
v_int = [(185, 175), (256, 320), (327, 175)]
draw.line(v_int, fill=(230, 232, 239, 255), width=16, joint="curve")

# Nodo central de escaneo (Matrix Green #2ecc71)
r_node = 16
draw.ellipse([256 - r_node, 320 - r_node, 256 + r_node, 320 + r_node], fill=(46, 204, 113, 255))

# Exportación directa a formato WebP
img.save("vortex-logo.webp", "WEBP", quality=95)
